# Supabase - browser-safe (injected into Vite bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase - server-only (service role bypasses RLS)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini - server-only (never expose to browser)
GEMINI_API_KEY=AIza...

# DeepSeek vision fallback - server-only
# DeepSeek's own api.deepseek.com does NOT accept image content, so the
# default below routes through OpenRouter to the vision-capable
# `deepseek/deepseek-vl2` model.  Put your OpenRouter key in DEEPSEEK_API_KEY.
# To use a different provider (SiliconFlow, Together, a self-hosted proxy,
# etc.) override DEEPSEEK_BASE_URL and DEEPSEEK_MODEL.
DEEPSEEK_API_KEY=sk-or-...
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-vl2

# Express server port
PORT=3001
